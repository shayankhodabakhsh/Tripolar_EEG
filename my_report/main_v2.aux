\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Ch6 --- Felt TCRE\,\#3 (eEEG conventional). Very clean signal; vertical impulse lines at artifact events are sharp and isolated.}}{9}{figure.caption.23}\protected@file@percent }
\newlabel{fig:spec_ch6}{{18}{9}{Ch6 --- Felt TCRE\,\#3 (eEEG conventional). Very clean signal; vertical impulse lines at artifact events are sharp and isolated}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Ch7 --- Felt TCRE\,\#4 (tEEG Laplacian). Clipping present but slightly less severe than Ch5; broadband noise dominates.}}{10}{figure.caption.24}\protected@file@percent }
\newlabel{fig:spec_ch7}{{19}{10}{Ch7 --- Felt TCRE\,\#4 (tEEG Laplacian). Clipping present but slightly less severe than Ch5; broadband noise dominates}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Ch8 --- Felt TCRE\,\#4 (eEEG conventional). Clean; alpha-band activity faintly visible during some eyes-closed periods.}}{10}{figure.caption.25}\protected@file@percent }
\newlabel{fig:spec_ch8}{{20}{10}{Ch8 --- Felt TCRE\,\#4 (eEEG conventional). Clean; alpha-band activity faintly visible during some eyes-closed periods}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Ch9 --- Paste TCRE\,\#5 (tEEG Laplacian). Cleanest tEEG channel; low-frequency alpha activity visible in the alpha band during resting state.}}{11}{figure.caption.26}\protected@file@percent }
\newlabel{fig:spec_ch9}{{21}{11}{Ch9 --- Paste TCRE\,\#5 (tEEG Laplacian). Cleanest tEEG channel; low-frequency alpha activity visible in the alpha band during resting state}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Ch10 --- Paste TCRE\,\#5 (eEEG conventional). Cleanest eEEG channel overall; very low noise floor with subtle alpha-band activity.}}{11}{figure.caption.27}\protected@file@percent }
\newlabel{fig:spec_ch10}{{22}{11}{Ch10 --- Paste TCRE\,\#5 (eEEG conventional). Cleanest eEEG channel overall; very low noise floor with subtle alpha-band activity}{figure.caption.27}{}}
