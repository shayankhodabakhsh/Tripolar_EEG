\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Ch4 --- Felt TCRE\,\#2 (eEEG conventional). Clean baseline; some residual broadband bursts near stimulus events.}}{8}{figure.caption.21}\protected@file@percent }
\newlabel{fig:spec_ch4}{{16}{8}{Ch4 --- Felt TCRE\,\#2 (eEEG conventional). Clean baseline; some residual broadband bursts near stimulus events}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Ch5 --- Felt TCRE\,\#3 (tEEG Laplacian). Worst clipping of all channels; spectrogram is saturated across all frequencies.}}{9}{figure.caption.22}\protected@file@percent }
